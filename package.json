{
  "name": "mamba",
  "version": "1.0.0",
  "description": "A polished React multi-chain wallet overview using Tether WDK for Bitcoin and Polygon.",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/api-contracts"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace @mamba/api\" \"npm run dev --workspace @mamba/web\"",
    "client": "npm run dev --workspace @mamba/web",
    "server": "npm run dev --workspace @mamba/api",
    "build": "npm run build --workspace @mamba/web",
    "test": "node --test",
    "start": "npm run start --workspace @mamba/api",
    "check": "npm run check --workspace @mamba/api"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
