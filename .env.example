# EVM testnet RPC configuration. Polygon Amoy is the default safe EVM network.
EVM_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
EVM_CHAIN_ID=80002
EVM_CHAIN_NAME=Polygon Amoy
EVM_NATIVE_SYMBOL=POL
EVM_EXPLORER_ADDRESS=https://amoy.polygonscan.com/address/
EVM_EXPLORER_TX=https://amoy.polygonscan.com/tx/
EVM_SWAP_MAX_FEE_WEI=200000000000000

# Bitcoin testnet Electrum configuration.
BTC_NETWORK=testnet
BTC_ELECTRUM_HOST=electrum.blockstream.info
BTC_ELECTRUM_PORT=60002
BTC_ELECTRUM_PROTOCOL=tls
BTC_EXPLORER_ADDRESS=https://mempool.space/testnet/address/
BTC_EXPLORER_TX=https://mempool.space/testnet/tx/

# Solana devnet RPC configuration.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
SOLANA_EXPLORER_ADDRESS=https://explorer.solana.com/address/
SOLANA_EXPLORER_TX=https://explorer.solana.com/tx/

# Local server.
PORT=8787
